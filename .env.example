# ============================================================
# STDOUT_CMS_ELF — 全量显式配置模板
# 复制此文件为 .env 后 docker compose up --build 即可运行
# ============================================================

# === Database ===
DB_USER=blog
DB_PASSWORD=blog
DB_NAME=stdoutcms
DB_PORT=5432

# === Redis ===
REDIS_PORT=6379

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# === Go Backend ===
APP_PORT=8080
APP_ENV=production

# 数据库连接（docker compose 内网）
DATABASE_URL=postgres://blog:blog@postgres:5432/stdoutcms?sslmode=disable
REDIS_URL=redis:6379

# Session 签名密钥（生产环境必须改成随机长串）
SESSION_SECRET=change-me-in-production

# 管理员账号（首次启动时自动创建）
ADMIN_USERNAME=root
ADMIN_PASSWORD=root

# 文件存储（连接 docker 内的 MinIO）
STORAGE_ENDPOINT=minio:9000
STORAGE_BUCKET=blog-assets
STORAGE_REGION=
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_CDN_BASE_URL=/img
STORAGE_USE_SSL=false

# === LLM (可选 — 解开注释并填写后启用 AI 聊天) ===
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o
# LLM_DAILY_LIMIT=50
